# Where the Greenlight backend (root Next.js app) is reachable.
# Defaults to the page origin on web, http://localhost:3000 otherwise.
# A phone on the LAN cannot resolve "localhost" — use the host machine's IP:
# EXPO_PUBLIC_API_URL=http://10.26.24.133:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
